  "interactionTransportAuthority": "4citeB4U/Leeway-live",
  "voiceAuthority": "4citeB4U/LeeWay-Voice-Fabric",
  "hardRules": [
    "discovery does not imply pairing",
    "pairing does not imply authorization",
    "authorization does not imply Formula admission",
    "dispatch does not imply ACK",
    "ACK does not imply read-back convergence",
    "read-back convergence does not imply canonical promotion without Veritas and receipt",
    "provider availability does not imply provider qualification",
    "source implementation does not imply live execution",
    "first success is not completion"
  ]
