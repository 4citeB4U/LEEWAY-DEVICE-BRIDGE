{
  "manifest_version": 3,
  "name": "LeeWay Sovereign Device Bridge",
  "short_name": "LeeWay Bridge",
  "version": "0.2.0",
  "description": "An owner-initiated browser interface to the existing LeeWay Device Bridge. Requires an enrolled native host.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open LeeWay Agent Tablet",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "background": { "scripts": ["browser-polyfill.js", "background.js"] },
  "browser_specific_settings": {
    "gecko": {
      "id": "device-bridge@leeway.industries",
      "strict_min_version": "109.0"
    }
  }
}
