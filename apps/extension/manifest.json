{
  "manifest_version": 3,
  "name": "LeeWay Sovereign Device Bridge",
  "description": "Owner-initiated, read-only browser observations for the LeeWay Device Bridge.",
  "version": "2.0.0",
  "action": { "default_title": "Open LeeWay Browser Courier" },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "minimum_chrome_version": "109"
}
