{
  "manifest_version": 3,
  "name": "LeeWay Sovereign Device Bridge",
  "version": "2.0.0",
  "description": "Owner-authorized browser courier for the local LeeWay Device Bridge.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:4280/*", "ws://127.0.0.1:4280/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["browser-polyfill.js", "background.js"]
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["browser-polyfill.js", "content-courier.js", "floating-tablet.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "action": { "default_title": "LeeWay Agent Virtual Tablet" },
  "browser_specific_settings": {
    "gecko": { "id": "bridge@leewayindustries.com", "strict_min_version": "121.0" },
    "safari": { "strict_min_version": "17.0" }
  }
}
