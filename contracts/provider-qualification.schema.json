{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leeway.local/contracts/provider-qualification.schema.json",
  "title": "LeeWay Provider Qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "providerId","capability","sourceQualified","configured",
    "liveObserved","physicalVerified","status"
  ],
  "properties": {
    "providerId":{"type":"string","minLength":1},
    "capability":{"type":"string","minLength":1},
    "sourceQualified":{"type":"boolean"},
    "configured":{"type":"boolean"},
    "liveObserved":{"type":"boolean"},
    "physicalVerified":{"type":"boolean"},
    "contractTests":{"type":"array","items":{"type":"string","minLength":1}},
    "evidenceRefs":{"type":"array","items":{"type":"string","minLength":1}},
    "status":{"enum":["PROPOSED","SOURCE_QUALIFIED","CONFIGURED","LIVE_OBSERVED","PHYSICAL_VERIFIED","DEGRADED","BLOCKED","FAILED"]}
  }
}
