{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leeway.local/contracts/calibration-policy.schema.json",
  "title": "LeeWay Device Calibration Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calibrationId","providerId","deviceClass","capability","dimensions",
    "minimumObservationCount","status","formulaExecutionAllowed"
  ],
  "properties": {
    "calibrationId":{"type":"string","minLength":1},
    "providerId":{"type":"string","minLength":1},
    "deviceClass":{"type":"string","minLength":1},
    "capability":{"type":"string","minLength":1},
    "dimensions":{
      "type":"array",
      "prefixItems":[
        {"const":"transport_integrity"},
        {"const":"authorization_integrity"},
        {"const":"readback_convergence"},
        {"const":"latency_margin"},
        {"const":"failsafe_readiness"},
        {"const":"provider_health"}
      ],
      "minItems":6,
      "maxItems":6
    },
    "minimumObservationCount":{"type":"integer","minimum":16},
    "observationRefs":{"type":"array","items":{"type":"string","minLength":1}},
    "rangeEvidenceRefs":{"type":"array","items":{"type":"string","minLength":1}},
    "timeoutPolicyRef":{"type":["string","null"]},
    "readbackPolicyRef":{"type":["string","null"]},
    "failSafePolicyRef":{"type":["string","null"]},
    "status":{"enum":["CANDIDATE","COLLECTING","CALIBRATED","AUTHORIZED","VERIFIED","BLOCKED","FAILED"]},
    "formulaExecutionAllowed":{"type":"boolean"}
  }
}
