{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leeway.local/contracts/promotion-policy.schema.json",
  "title": "LeeWay Device Capability Promotion Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "promotionId","capability","currentState","targetState",
    "requiredEvidence","testsPassed","rollbackRef","approvedBy","status"
  ],
  "properties": {
    "promotionId":{"type":"string","minLength":1},
    "capability":{"type":"string","minLength":1},
    "currentState":{"enum":["PROPOSED","SOURCE_IMPLEMENTED","SOURCE_QUALIFIED","LIVE_OBSERVED","PHYSICAL_VERIFIED"]},
    "targetState":{"enum":["SOURCE_QUALIFIED","LIVE_OBSERVED","PHYSICAL_VERIFIED","CANONICAL"]},
    "requiredEvidence":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "testsPassed":{"type":"array","items":{"type":"string","minLength":1}},
    "rollbackRef":{"type":"string","minLength":1},
    "approvedBy":{"type":"string","minLength":1},
    "status":{"enum":["PENDING","ADMITTED","REJECTED","ROLLED_BACK","BLOCKED"]}
  }
}
