# LeeWay public routing (do not put credentials or tokens in VITE_ variables).
# All URLs must be approved HTTPS routes under the existing LeeWay/Zitadel authority.
VITE_LEEWAY_CREATOR_SIGNIN_URL=
VITE_LEEWAY_CUSTOMER_SIGNIN_URL=
VITE_LEEWAY_INVITATION_URL=
VITE_LEEWAY_DEVICE_PAIR_URL=
VITE_LEEWAY_SESSION_URL=
VITE_LEEWAY_TABLET_URL=

# Optional public contact channels. Leave blank when no verified value exists;
# the Contact Us section then falls back to the LeeWay Device Bridge issues page.
# Do not invent an email address or phone number.
VITE_LEEWAY_CONTACT_EMAIL=
VITE_LEEWAY_CONTACT_PHONE=
VITE_LEEWAY_CONTACT_URL=
