{
  "name": "leeway-device-bridge-workspace",
  "private": true,
  "type": "module",
  "bin": {
    "leeway-bridge": "./operator/device-bridge-cli.mjs"
  },
  "workspaces": [
    "packages/*",
    "apps/desktop"
  ],
  "dependencies": {
    "ws": "8.22.0"
  },
  "scripts": {
    "test:mcp": "node --test tests/mcp/*.test.mjs",
    "test:installation-adapter": "node --test tests/installation-adapter.test.mjs",
    "test:windows-native-installer": "node --test tests/windows-native-installer.test.mjs",
    "test:hp-secondary-legacy-retirement": "node --test tests/hp-secondary-legacy-retirement.test.mjs",
    "test:physical-adapter-routing": "node --test tests/physical-adapter-routing.test.mjs",
    "test:iloader-observer": "node --test tests/windows-iloader-observer.test.mjs",
    "observe:iloader": "node scripts/observe-windows-iloader.mjs",
    "test:cli": "node --test tests/cli/*.test.mjs",
    "bridge": "node operator/device-bridge-cli.mjs",
    "mcp": "node apps/desktop/mcp-server.mjs",
    "start:public-mcp": "node operator/hosting/start-public-mcp-ingress.mjs",
    "voice:auth-gateway": "node operator/voice-auth-gateway.mjs",
    "voice:qualify-c3": "node scripts/qualify-c3-live.mjs",
    "test:voice-auth": "node --test tests/voice-auth-gateway.test.mjs tests/voice-passwordless-pairing.test.mjs tests/voice-app-registry.test.mjs",
    "voice:owner-start": "node operator/voice-auth-owner-start.mjs",
    "voice:owner-approve": "node operator/voice-owner-approval-desktop.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
