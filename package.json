{
  "name": "leeway-device-bridge-workspace",
  "private": true,
  "type": "module",
  "bin": { "leeway-bridge": "./operator/device-bridge-cli.mjs" },
  "workspaces": ["packages/*", "apps/desktop"],
  "scripts": {
    "test:mcp": "node --test tests/mcp/*.test.mjs",
    "test:installation-adapter": "node --test tests/installation-adapter.test.mjs",
    "test:iloader-observer": "node --test tests/windows-iloader-observer.test.mjs",
    "observe:iloader": "node scripts/observe-windows-iloader.mjs",
    "test:cli": "node --test tests/cli/*.test.mjs",
    "bridge": "node operator/device-bridge-cli.mjs",
    "voice:auth-gateway": "node operator/voice-auth-gateway.mjs",
    "test:voice-auth": "node --test tests/voice-auth-gateway.test.mjs tests/voice-duplex.test.mjs",
    "mcp": "node apps/desktop/mcp-server.mjs"
  },
  "engines": { "node": ">=22" }
}
